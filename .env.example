# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.

# Clerk publishable key (safe for client-side / Expo public bundles)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Clerk secret key — SERVER-SIDE ONLY.
# Never set this in .env committed to source control.
# Store it in your CI/CD secrets or a secrets manager (e.g. EAS Secrets).
CLERK_SECRET_KEY=sk_test_your_secret_key_here
